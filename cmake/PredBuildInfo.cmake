# Writes the build's version, number and commit into a small source file (OUTPUT), run at every build: the number is how
# many commits there are, so every pushed build has its own, and a "+" after it means there were changes not yet
# committed. Only written when something changed, so nothing rebuilds otherwise.
#   cmake -DSOURCE_DIR=... -DOUTPUT=... -DVERSION=... -P PredBuildInfo.cmake
set(build "0")
set(commit "unknown")
find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-list --count HEAD WORKING_DIRECTORY "${SOURCE_DIR}"
                    OUTPUT_VARIABLE build OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --short HEAD WORKING_DIRECTORY "${SOURCE_DIR}"
                    OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no WORKING_DIRECTORY "${SOURCE_DIR}"
                    OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(changes)
        string(APPEND build "+")
    endif()
endif()
if(build STREQUAL "")
    set(build "0")
endif()
set(text "// Generated by cmake/PredBuildInfo.cmake at build time. Do not edit.
#include \"Engine/Core/BuildInfo.h\"

namespace pred::BuildInfo
{

const char* Version() { return \"${VERSION}\"; }
const char* Build() { return \"${build}\"; }
const char* Commit() { return \"${commit}\"; }
const char* Label() { return \"v${VERSION} build ${build}\"; }

} // namespace pred::BuildInfo
")
set(old "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUTPUT}" "${text}")
endif()
